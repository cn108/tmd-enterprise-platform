# Copy to backend/.env for local development. Never commit the copy.
# Values below are development placeholders only and match infra/docker-compose.yml.

DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=dev-only-insecure-key-not-for-production
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

POSTGRES_DB=tmd
POSTGRES_USER=tmd
POSTGRES_PASSWORD=tmd_dev_password
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5433

REDIS_URL=redis://127.0.0.1:6379/0

LOG_LEVEL=INFO
APP_VERSION=0.1.0
