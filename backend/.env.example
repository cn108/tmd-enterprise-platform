# Copy to backend/.env for local development. Never commit the copy.
# Values below are development placeholders only and match infra/docker-compose.yml.

DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=dev-only-insecure-key-not-for-production
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# The Angular dev server proxies /api to this backend, so its origin must be trusted.
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:4200,http://127.0.0.1:4200,http://localhost:49630,http://127.0.0.1:49630
# Comma-separated Fernet keys for bank account encryption (first encrypts, all decrypt).
# Generate one with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
BANK_ACCOUNT_ENCRYPTION_KEYS=

POSTGRES_DB=tmd
POSTGRES_USER=tmd
POSTGRES_PASSWORD=tmd_dev_password
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5433

REDIS_URL=redis://127.0.0.1:6379/0

# Outbound email for invoice PDFs. Use a Gmail App Password, not the normal
# mailbox password. Generate one under Google Account → Security → App passwords.
# Leave EMAIL_HOST_PASSWORD blank to keep delivery disabled.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_HOST_USER=ccmtico1234@gmail.com
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=Tico McDon Limited <ccmtico1234@gmail.com>

LOG_LEVEL=INFO
APP_VERSION=0.1.0
