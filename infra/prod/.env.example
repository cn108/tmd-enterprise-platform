# Copy outside the repository (for example /etc/tmd/production.env), restrict
# permissions to the deployment account, and inject it through the platform's
# secret manager. Never commit the filled copy.

COMPOSE_PROJECT_NAME=tmd-production
TMD_DOMAIN=erp.example.com
HTTP_PORT=80
HTTPS_PORT=443
TLS_CERT_DIR=/etc/tmd/tls

POSTGRES_DB=tmd_production
POSTGRES_USER=tmd_app
POSTGRES_PASSWORD=
DJANGO_SECRET_KEY=
BANK_ACCOUNT_ENCRYPTION_KEYS=
MFA_ENCRYPTION_KEY=
MFA_REQUIRED_FOR_ALL_USERS=true
MFA_ISSUER=Tico McDon Limited
REDIS_PASSWORD=

EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.company.example
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=Tico McDon Limited <no-reply@company.example>

API_USER_RATE=5000/hour
API_ANON_RATE=120/hour
LOGIN_RATE=10/min
MFA_RATE=10/min

LOG_LEVEL=INFO
APP_VERSION=
GUNICORN_WORKERS=3
GUNICORN_TIMEOUT=60
