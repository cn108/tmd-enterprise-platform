# Copy outside the repository (for example /etc/tmd/production.env), restrict
# permissions to the deployment account, and inject it through the platform's
# secret manager. Never commit the filled copy.

COMPOSE_PROJECT_NAME=tmd-production
TMD_DOMAIN=erp.example.com
HTTP_PORT=80
HTTPS_PORT=443
TLS_CERT_DIR=/etc/tmd/tls

POSTGRES_DB=tmd_production
POSTGRES_USER=tmd_app
POSTGRES_PASSWORD=
DJANGO_SECRET_KEY=
BANK_ACCOUNT_ENCRYPTION_KEYS=
REDIS_PASSWORD=

LOG_LEVEL=INFO
APP_VERSION=
GUNICORN_WORKERS=3
GUNICORN_TIMEOUT=60
